generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Currency {
  USD
  ARS
}

enum ExpenseType {
  FIXED
  VARIABLE
}

enum FinancialStatus {
  PAID
  PENDING
}

model Client {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  contactName  String?   @map("contact_name")
  contactEmail String?   @map("contact_email")
  contactPhone String?   @map("contact_phone")
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  projects     Project[]
  incomes      Income[]

  @@map("clients")
}

model Project {
  id                             String    @id @default(uuid()) @db.Uuid
  clientId                       String    @map("client_id") @db.Uuid
  name                           String
  isActive                       Boolean   @default(true) @map("is_active")
  startDate                      DateTime? @map("start_date") @db.Date
  endDate                        DateTime? @map("end_date") @db.Date
  goLiveDate                     DateTime? @map("go_live_date") @db.Date
  notes                          String?
  clientSharedFolderUrl          String?   @map("client_shared_folder_url")
  clientSharedFolderLabel        String?   @map("client_shared_folder_label")
  oneTimeOriginalAmount          Decimal?  @map("one_time_original_amount") @db.Decimal(18, 6)
  oneTimeCurrency                Currency? @map("one_time_currency")
  oneTimeExchangeRate            Decimal?  @map("one_time_exchange_rate") @db.Decimal(18, 6)
  oneTimeAmountUsd               Decimal?  @map("one_time_amount_usd") @db.Decimal(18, 6)
  monthlyRecurringOriginalAmount Decimal?  @map("monthly_recurring_original_amount") @db.Decimal(18, 6)
  monthlyRecurringCurrency       Currency? @map("monthly_recurring_currency")
  monthlyRecurringExchangeRate   Decimal?  @map("monthly_recurring_exchange_rate") @db.Decimal(18, 6)
  monthlyRecurringAmountUsd      Decimal?  @map("monthly_recurring_amount_usd") @db.Decimal(18, 6)
  createdAt                      DateTime  @default(now()) @map("created_at")
  updatedAt                      DateTime  @updatedAt @map("updated_at")
  client                         Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  incomes                        Income[]
  expenses                       Expense[]
  phases                         ProjectPhase[]
  tasks                          ProjectTask[]
  shareLink                      ProjectShareLink?
  hourAssignments               HourAssignment[]
  timeEntries                   TimeEntry[]
  operationalTasks             OperationalTask[]

  @@index([clientId])
  @@index([isActive])
  @@index([clientId, isActive])
  @@map("projects")
}

enum AppUserRole {
  ADMIN
  COLLABORATOR
}

model AppUser {
  id                  String            @id @default(uuid()) @db.Uuid
  name                String
  email               String            @unique
  passwordHash        String            @map("password_hash")
  role                AppUserRole       @default(COLLABORATOR)
  isActive            Boolean           @default(false) @map("is_active")
  sessionVersion      Int               @default(0) @map("session_version")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  assignments         HourAssignment[]
  createdEntries      TimeEntry[]       @relation("time_entry_creator")
  workedEntries       TimeEntry[]       @relation("time_entry_worker")
  modifiedEntries     TimeEntry[]       @relation("time_entry_modifier")
  auditEvents         TimeEntryAudit[]  @relation("audit_actor")
  accessTokens        AccessToken[]
  createdOperationalTasks  OperationalTask[] @relation("operational_task_creator")
  assignedOperationalTasks OperationalTask[] @relation("operational_task_assignee")

  @@index([role, isActive])
  @@map("app_users")
}

model AccessToken {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  tokenHash   String   @unique @map("token_hash")
  purpose     String
  expiresAt   DateTime @map("expires_at")
  usedAt      DateTime? @map("used_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime @default(now()) @map("created_at")
  user        AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
  @@map("access_tokens")
}

model HourAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  user      AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId])
  @@map("hour_assignments")
}

model TimeEntry {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  projectId       String          @map("project_id") @db.Uuid
  workDate        DateTime        @map("work_date") @db.Date
  minutes         Int
  description     String
  referenceUrl    String?         @map("reference_url")
  status          String          @default("ACTIVE")
  createdById     String          @map("created_by_id") @db.Uuid
  modifiedById    String?         @map("modified_by_id") @db.Uuid
  voidReason      String?         @map("void_reason")
  idempotencyKey  String?         @unique @map("idempotency_key")
  operationalTaskId String?       @map("operational_task_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  user            AppUser         @relation("time_entry_worker", fields: [userId], references: [id], onDelete: Restrict)
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdBy       AppUser         @relation("time_entry_creator", fields: [createdById], references: [id], onDelete: Restrict)
  modifiedBy      AppUser?        @relation("time_entry_modifier", fields: [modifiedById], references: [id], onDelete: Restrict)
  audits          TimeEntryAudit[]
  operationalTask OperationalTask? @relation(fields: [operationalTaskId], references: [id], onDelete: SetNull)

  @@index([userId, workDate, status])
  @@index([projectId, workDate, status])
  @@index([operationalTaskId, status])
  @@map("time_entries")
}

model TimeEntryAudit {
  id          String    @id @default(uuid()) @db.Uuid
  entryId     String    @map("entry_id") @db.Uuid
  actorId     String    @map("actor_id") @db.Uuid
  action      String
  reason      String?
  beforeJson  Json?     @map("before_json")
  afterJson   Json?     @map("after_json")
  createdAt   DateTime  @default(now()) @map("created_at")
  entry       TimeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  actor       AppUser   @relation("audit_actor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entryId, createdAt])
  @@map("time_entry_audits")
}

model IncomeType {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  requiresProject Boolean   @default(false) @map("requires_project")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  incomes         Income[]

  @@unique([name])
  @@map("income_types")
}

model Income {
  id            String          @id @default(uuid()) @db.Uuid
  clientId      String?         @map("client_id") @db.Uuid
  projectId     String?         @map("project_id") @db.Uuid
  typeId        String          @map("type_id") @db.Uuid
  concept       String
  notes         String?
  status        FinancialStatus @default(PAID)
  amountUsd     Decimal         @map("amount_usd") @db.Decimal(18, 6)
  amountArs     Decimal?        @map("amount_ars") @db.Decimal(18, 2)
  exchangeRate  Decimal?        @map("exchange_rate") @db.Decimal(18, 6)
  dueDate       DateTime?       @map("due_date") @db.Date
  effectiveDate DateTime?       @map("effective_date") @db.Date
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  client        Client?         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project       Project?        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  type          IncomeType      @relation(fields: [typeId], references: [id], onDelete: Restrict)

  @@index([clientId])
  @@index([projectId])
  @@index([typeId])
  @@index([status, dueDate])
  @@index([status, effectiveDate])
  @@map("incomes")
}

model ExpenseCategory {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  expenses  Expense[]

  @@map("expense_categories")
}

model Expense {
  id                String          @id @default(uuid()) @db.Uuid
  expenseCategoryId String          @map("expense_category_id") @db.Uuid
  projectId         String?         @map("project_id") @db.Uuid
  type              ExpenseType     @map("expense_type")
  concept           String
  notes             String?
  status            FinancialStatus @default(PAID)
  amountUsd         Decimal         @map("amount_usd") @db.Decimal(18, 6)
  amountArs         Decimal?        @map("amount_ars") @db.Decimal(18, 2)
  exchangeRate      Decimal?        @map("exchange_rate") @db.Decimal(18, 6)
  dueDate           DateTime?       @map("due_date") @db.Date
  effectiveDate     DateTime?       @map("effective_date") @db.Date
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  category          ExpenseCategory @relation(fields: [expenseCategoryId], references: [id], onDelete: Restrict)
  project           Project?        @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([expenseCategoryId])
  @@index([projectId])
  @@index([type])
  @@index([status, dueDate])
  @@index([status, effectiveDate])
  @@map("expenses")
}

enum ProjectTaskType {
  TASK
  MILESTONE
}

enum ProjectTaskStatus {
  TODO
  IN_PROGRESS
  TO_REVIEW
  BLOCKED
  DONE
}

enum OperationalTaskStatus {
  PENDING
  IN_PROGRESS
  BLOCKED
  DONE
}

model OperationalTask {
  id            String                @id @default(uuid()) @db.Uuid
  title         String
  description   String?
  status        OperationalTaskStatus @default(PENDING)
  creatorId     String                @map("creator_id") @db.Uuid
  assigneeId    String                @map("assignee_id") @db.Uuid
  projectId     String?               @map("project_id") @db.Uuid
  dueDate       DateTime?             @map("due_date") @db.Date
  blockedReason String?               @map("blocked_reason")
  completedAt   DateTime?             @map("completed_at")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")
  creator       AppUser               @relation("operational_task_creator", fields: [creatorId], references: [id], onDelete: Restrict)
  assignee      AppUser               @relation("operational_task_assignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  project       Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  timeEntries   TimeEntry[]

  @@index([assigneeId, status, dueDate])
  @@index([projectId, status])
  @@index([status, dueDate])
  @@index([updatedAt])
  @@map("operational_tasks")
}

model ProjectPhase {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     ProjectTask[]

  @@index([projectId, position])
  @@map("project_phases")
}

model ProjectTask {
  id            String           @id @default(uuid()) @db.Uuid
  projectId     String           @map("project_id") @db.Uuid
  phaseId       String?          @map("phase_id") @db.Uuid
  name          String
  description   String?
  type          ProjectTaskType  @default(TASK)
  startDate     DateTime         @map("start_date") @db.Date
  endDate       DateTime         @map("end_date") @db.Date
  status        ProjectTaskStatus @default(TODO)
  position      Int              @default(0)
  clientVisible Boolean          @default(true) @map("client_visible")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase         ProjectPhase?    @relation(fields: [phaseId], references: [id], onDelete: SetNull)

  @@index([projectId, phaseId, position])
  @@index([projectId, status])
  @@map("project_tasks")
}

model ProjectShareLink {
  id                String    @id @default(uuid()) @db.Uuid
  projectId         String    @map("project_id") @db.Uuid
  slug              String    @unique
  passwordHash      String    @map("password_hash")
  passwordEncrypted String    @map("password_encrypted")
  accessVersion     Int       @default(0) @map("access_version")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  revokedAt         DateTime? @map("revoked_at")
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId])
  @@map("project_share_links")
}
