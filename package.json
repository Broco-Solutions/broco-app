{
  "name": "broco-finance",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "data:extract": "tsx scripts/extract-finance-xlsx.ts",
    "db:seed:test": "NODE_ENV=test ALLOW_DESTRUCTIVE_TEST_DB=true DATABASE_URL=postgresql://mock:mock@localhost:9999/broco_finance_prod DATABASE_URL_TEST=postgresql://broco_test:broco_test@localhost:5434/broco_finance_test tsx prisma/seed.ts",
    "db:test:constraints": "NODE_ENV=test DATABASE_URL=postgresql://mock:mock@localhost:9999/broco_finance_prod DATABASE_URL_TEST=postgresql://broco_test:broco_test@localhost:5434/broco_finance_test tsx scripts/ensure-test-constraints.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "prod:inventory": "tsx scripts/capture-production-inventory.ts",
    "prod:inventory:compare": "tsx scripts/compare-production-inventories.ts",
    "prod:migrate:hours-auth": "tsx scripts/migrate-hours-auth-production.ts",
    "seed:hours:test": "NODE_ENV=test tsx scripts/seed-hours-test.ts",
    "test": "vitest run",
    "test:unit": "vitest run --dir tests/unit",
    "test:integration": "test -n \"$DATABASE_URL_TEST\" || (echo \"DATABASE_URL_TEST no esta definida\" && exit 1); vitest run tests/integration/smoke-db.test.ts && DATABASE_URL=\"$DATABASE_URL_TEST\" vitest run tests/integration/clients-projects.test.ts tests/integration/incomes.test.ts tests/integration/expenses-dashboard.test.ts tests/integration/reconciliation.test.ts tests/integration/thirty-days.test.ts tests/integration/dashboard-kpis.test.ts tests/integration/date-filters.test.ts",
    "test:prod-prep": "vitest run tests/integration/production-hours-auth-runner.test.ts tests/integration/production-inventory.test.ts tests/unit/production-target.test.ts tests/unit/sot-inventory.test.ts",
    "test:e2e": "pnpm exec playwright test tests/e2e/ --workers=1",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d",
    "test:db:down": "docker compose -f docker-compose.test.yml down",
    "test:db:status": "docker compose -f docker-compose.test.yml ps"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@next-auth/prisma-adapter": "1.0.7",
    "@prisma/client": "^6.19.2",
    "bcryptjs": "3.0.2",
    "bubblewrap": "^0.2.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dhtmlx-gantt": "^10.0.2",
    "jose": "6.2.10",
    "lucide-react": "^0.577.0",
    "mcp-handler": "2.1.1",
    "next": "^14.2.35",
    "next-auth": "4.24.11",
    "prisma": "^6.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "^20.19.37",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.4.27",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "xlsx": "^0.18.5"
  }
}
